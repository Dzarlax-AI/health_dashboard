# Generated release identity. Never substitute mutable tags.
HEALTH_PAIR_IMAGE=ghcr.io/dzarlax-ai/health_dashboard-pair@sha256:changeme
HEALTH_PAIR_REVISION=changeme
HEALTH_API_CONTRACT_VERSION=1.0.0
HEALTH_BACKEND_IMAGE=ghcr.io/dzarlax-ai/health_dashboard@sha256:changeme
HEALTH_FRONTEND_IMAGE=ghcr.io/dzarlax-ai/health_dashboard-frontend@sha256:changeme

# Generated route state: canary, cutover, or rollback.
HEALTH_FRONTEND_ROUTE_MODE=canary
HEALTH_FRONTEND_TRAEFIK_ENABLED=true
HEALTH_FRONTEND_ROOT_RULE='Host(`health.dzarlax.dev`) && Path(`/`) && HeaderRegexp(`Cookie`, `(^|;[ ]*)health_frontend_canary=1(;|[ ]*$)`)'
HEALTH_FRONTEND_ASSETS_RULE='Host(`health.dzarlax.dev`) && PathPrefix(`/assets/`) && HeaderRegexp(`Cookie`, `(^|;[ ]*)health_frontend_canary=1(;|[ ]*$)`)'

# Runtime secrets and tenant database settings remain in an untracked .env
# beside docker-compose.yml. They are intentionally not duplicated here.
