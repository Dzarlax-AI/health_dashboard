# ── Database ────────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL=postgres://health_user:password@localhost:5432/aistack?search_path=health

# Additive tenant database isolation rollout. Disabled by default; DATABASE_URL
# remains the startup contract until the restricted-pool wiring is enabled.
TENANT_DB_ISOLATION_ENABLED=false
# One-time/recovery CLI inputs for the fixed database identity bootstrap.
# PostgreSQL 16+ is required. Keep all real values in root-owned secret storage;
# the CLI never emits them. This DSN is independent of isolation enablement.
TENANT_DB_BOOTSTRAP_DATABASE_URL=postgres://postgres:password@localhost:5432/aistack
HEALTH_ADMIN_DB_PASSWORD=
HEALTH_REGISTRY_DB_PASSWORD=
# Required only when TENANT_DB_ISOLATION_ENABLED=true. Keep real values in
# deployment secret storage. The tenant URL base must not contain credentials.
ADMIN_DATABASE_URL=postgres://health_admin:password@localhost:5432/aistack
REGISTRY_DATABASE_URL=postgres://health_registry:password@localhost:5432/aistack?search_path=health_registry
TENANT_DATABASE_URL_BASE=postgres://localhost:5432/aistack
# Base64/base64url encoded secrets; decoded values must contain at least 32 bytes.
TENANT_DB_MASTER_SECRET=
TENANT_DB_MASTER_SECRET_VERSION=
# Optional dual-secret rotation window; configure both previous values or neither.
TENANT_DB_PREVIOUS_MASTER_SECRET=
TENANT_DB_PREVIOUS_MASTER_SECRET_VERSION=

# ── Server ───────────────────────────────────────────────────────────────────────
# Listen address (default: :8080)
ADDR=:8080

# Public base URL — used in MCP server logs
BASE_URL=https://health.example.com

# ── Auth ─────────────────────────────────────────────────────────────────────────
# API key for POST /health (data ingestion) and /mcp endpoints
API_KEY=changeme

# Password for the web UI at /
UI_PASSWORD=changeme

# Admin email — used for Authentik SSO matching via X-authentik-email header (optional)
ADMIN_EMAIL=

# One-time capability required by POST /setup on a fresh multi-user install.
# Generate with: openssl rand -hex 32. Keep secret; remove/rotate after setup closes.
SETUP_TOKEN=

# Set to "true" to trust X-authentik-username / X-authentik-email headers (Authentik ForwardAuth)
# Requires an explicit TRUSTED_FORWARD_AUTH_NETWORK CIDR allow-list.
# TRUSTED_FORWARD_AUTH_NETWORK=10.0.0.0/8
TRUST_FORWARD_AUTH=false

# ── Telegram notifications ────────────────────────────────────────────────────────
# Both required to enable Telegram reports
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Report language: en | ru | sr (default: en)
REPORT_LANG=en

# Timezone for scheduling (IANA name, e.g. Europe/Belgrade). Defaults to system local.
REPORT_TZ=Europe/Belgrade

# Hour (0–23) to send the morning report
REPORT_MORNING_WEEKDAY=8
REPORT_MORNING_WEEKEND=9

# Hour (0–23) to send the evening report
REPORT_EVENING_WEEKDAY=20
REPORT_EVENING_WEEKEND=21

# ── AI morning briefing (Gemini) ──────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=

# Model to use (default: gemini-2.5-flash). Other options: gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Max output tokens for the AI briefing (default: 5000)
GEMINI_MAX_TOKENS=5000
